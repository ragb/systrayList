#. Translators: Message to be announced during Keyboard Help
#: addon\globalPlugins\systrayList\__init__.py:99
msgid ""
"Shows the list of buttons on the System Tray. If pressed twice quickly, "
"shows the items on the taskbar."
msgstr ""
"Mostra a lista de botões na área de notificação. Se pressionada duas vezes "
"rapidamente, mostra os itens na barra de tarefas."

#. Translators: Name of the section in "Input gestures" dialog.
#: addon\globalPlugins\systrayList\__init__.py:101
msgid "Systray list"
msgstr "Lista da área de notificação"

#: addon\globalPlugins\systrayList\__init__.py:124
msgid "System Tray List"
msgstr "Lista da área de notificação"

#: addon\globalPlugins\systrayList\__init__.py:124
msgid "Icons on the System Tray:"
msgstr "Ícones da área de notificação:"

#: addon\globalPlugins\systrayList\__init__.py:133
msgid "Taskbar List"
msgstr "Lista da barra de tarefas"

#: addon\globalPlugins\systrayList\__init__.py:133
msgid "Icons of running applications on the taskbar:"
msgstr "Ícones dos aplicativos em execução na barra de tarefas:"

#. Translators: A button on the system tray list dialog to perform left mouse click.
#: addon\globalPlugins\systrayList\__init__.py:188
msgid "&Left Click"
msgstr "&Clique Esquerdo"

#. Translators: A button in the system tray list dialog to perform left double mouse click.
#: addon\globalPlugins\systrayList\__init__.py:192
msgid "Left &Double Click"
msgstr "Duplo Clique &Esquerdo"

#. Translators: A button in the system tray list dialog to perform right mouse click.
#: addon\globalPlugins\systrayList\__init__.py:196
msgid "&Right Click"
msgstr "Clique &Direito"

#. Add-on summary/title, usually the user visible name of the add-on
#. Translators: Summary/title for this add-on
#. to be shown on installation and add-on information found in add-on store
#: buildVars.py:21
msgid "SysTrayList"
msgstr "Lista da área de notificação"

#. Add-on description
#. Translators: Long description to be shown for this add-on on add-on information from add-on store
#: buildVars.py:24
msgid ""
"Shows the list of buttons on the System Tray with NVDA+F11 once, twice shows "
"running task lists."
msgstr ""
"Mostra a lista de botões da área de notificação com NVDA+F11 pressionada uma "
"vez, duas vezes mostra a lista de tarefas executando."

#. Brief changelog for this version
#. Translators: what's new content for the add-on version to be shown in the add-on store
#: buildVars.py:29
msgid ""
"Corrected bugs:\n"
"\t- Routine to perform the mouse clicks;\n"
"\t- Routine to get the taskbar buttons on Windows 11 25H2."
msgstr ""
"Erros corrigidos: - Rotina para realizar cliques do mouse; - Rotina para "
"obter os botões da barra de tarefas no Windows 11 25H2."
