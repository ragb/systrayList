#. For translators: Message to be announced during Keyboard Help
#: addon\globalPlugins\systrayList\__init__.py:81
msgid ""
"Shows the list of buttons on the System Tray. If pressed twice quickly, "
"shows the items on the taskbar."
msgstr ""
"Wyświetla listę przycisków w obszarze powiadomień. Szybkie dwukrotne "
"naciśnięcie skrótu wyświetla elementy paska zadań."

#. For translators: Name of the section in "Input gestures" dialog.
#: addon\globalPlugins\systrayList\__init__.py:83
msgid "Systray list"
msgstr "Lista ikon obszaru powiadomień"

#: addon\globalPlugins\systrayList\__init__.py:103
msgid "System Tray List"
msgstr "Lista obszaru powiadomień"

#: addon\globalPlugins\systrayList\__init__.py:103
msgid "Icons on the System Tray:"
msgstr "Ikony w obszarze powiadomień:"

#: addon\globalPlugins\systrayList\__init__.py:107
msgid "Taskbar List"
msgstr "Lista paska zadań"

#: addon\globalPlugins\systrayList\__init__.py:107
msgid "Icons of running applications on the taskbar:"
msgstr "Ikony uruchomionych aplikacji na pasku zadań:"

#. Translators: A button on the system tray list dialog to perform left mouse click.
#: addon\globalPlugins\systrayList\__init__.py:143
msgid "&Left Click"
msgstr "Kliknięcie &lewym przyciskiem myszy"

#. Translators: A button in the system tray list dialog to perform left double mouse click.
#: addon\globalPlugins\systrayList\__init__.py:147
msgid "Left &Double Click"
msgstr "&Dwukrotne kliknięcie lewym przyciskiem myszy"

#. Translators: A button in the system tray list dialog to perform right mouse click.
#: addon\globalPlugins\systrayList\__init__.py:151
msgid "&Right Click"
msgstr "Kliknięcie &prawym przyciskiem myszy"

#. Add-on summary, usually the user visible name of the addon.
#. Translators: Summary for this add-on to be shown on installation and add-on information.
#: buildVars.py:17
msgid "SysTrayList"
msgstr "Lista ikon obszaru powiadomień"

#. Add-on description
#. Translators: Long description to be shown for this add-on on add-on information from add-ons manager
#: buildVars.py:20
msgid ""
"Shows the list of buttons on the System Tray with NVDA+F11 once, twice shows "
"running task lists."
msgstr ""
"Jednokrotne naciśnięcie NVDA+F11 wyświetla listę przycisków w obszarze "
"powiadomień, a szybkie dwukrotne naciśnięcie — listę uruchomionych "
"aplikacji na pasku zadań."
