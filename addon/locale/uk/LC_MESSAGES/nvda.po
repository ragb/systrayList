#: addon\globalPlugins\systrayList\__init__.py:107
msgid "Shows the list of buttons on the System Tray. If pressed twice quickly, shows the items on the taskbar."
msgstr "Показує список кнопок на системній панелі. При швидкому подвійному натисненні показує елементи панелі завдань."

#. Translators: Name of the section in "Input gestures" dialog.
#: addon\globalPlugins\systrayList\__init__.py:110
msgid "Systray list"
msgstr "Список системної панелі"

#: addon\globalPlugins\systrayList\__init__.py:135
msgid "System Tray List"
msgstr "Список системної панелі"

#: addon\globalPlugins\systrayList\__init__.py:135
msgid "Icons on the System Tray:"
msgstr "Іконки на системній панелі:"

#: addon\globalPlugins\systrayList\__init__.py:149
msgid "Taskbar List"
msgstr "Список панелі завдань"

#: addon\globalPlugins\systrayList\__init__.py:150
msgid "Icons of running applications on the taskbar:"
msgstr "Список запущених програм на панелі завдань:"

#. Translators: A button on the system tray list dialog to perform left mouse click.
#: addon\globalPlugins\systrayList\__init__.py:211
msgid "&Left Click"
msgstr "&Лівий клік"

#. Translators: A button in the system tray list dialog to perform left double mouse click.
#: addon\globalPlugins\systrayList\__init__.py:215
msgid "Left &Double Click"
msgstr "Подвійний &лівий клік"

#. Translators: A button in the system tray list dialog to perform right mouse click.
#: addon\globalPlugins\systrayList\__init__.py:219
msgid "&Right Click"
msgstr "&Правий клік"

#. Add-on summary/title, usually the user visible name of the add-on
#. Translators: Summary/title for this add-on
#. to be shown on installation and add-on information found in add-on store
#: buildVars.py:21
msgid "SysTrayList"
msgstr "Список системної панелі"

#. Add-on description
#. Translators: Long description to be shown for this add-on on add-on information from add-on store
#: buildVars.py:24
msgid "Shows the list of buttons on the System Tray with NVDA+F11 once, twice shows running task lists."
msgstr "Показує список кнопок системної панелі при одноразовому натисканні клавіатурної комбінації NVDA+F11. При швидкому подвійному натисканні показує список запущених завдань."

